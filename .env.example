# Copy to .env (git-ignored) and fill in locally, or run lab/scripts/init-env.sh
# to generate the values. Placeholder names only; never commit real values.
POSTGRES_PASSWORD=change-me
EXA_PROXY_SECRET=change-me
EXA_ADMIN_EMAIL=admin@example.org
EXA_ADMIN_PASSWORD=change-me
# Optional: "Ask your network" (any OpenAI-compatible API; DeepInfra by default).
EXA_LLM_API_KEY=
# EXA_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Hurricane watch feed; set empty to turn it off.
# EXA_NHC_URL=https://www.nhc.noaa.gov/CurrentStorms.json
# Disaster watch feeds (ADR 0008); set any of them empty to turn that feed off.
# EXA_USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson
# EXA_GDACS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
# EXA_TSUNAMI_URLS=https://www.tsunami.gov/events/xml/PHEBAtom.xml,https://www.tsunami.gov/events/xml/PAAQAtom.xml
# Sign-in (ADR 0017). Secure session cookie; set 0 only for plain-HTTP testing.
# EXA_COOKIE_SECURE=1
# Where people reach the portal, e.g. https://connect.example.org
EXA_PUBLIC_URL=
# Sign-in gateway (Keycloak, `docker compose --profile sso up`). Off while empty.
EXA_OIDC_ISSUER=
EXA_OIDC_CLIENT_ID=exacarib-connect
EXA_OIDC_CLIENT_SECRET=
# Sign-in buttons; add microsoft once its email trust is settled (ADR 0017).
# EXA_OIDC_IDPS=google
# Service-account client for enterprise SSO set-up (Keycloak admin API).
EXA_KEYCLOAK_ADMIN_CLIENT_ID=exacarib-controller-admin
EXA_KEYCLOAK_ADMIN_CLIENT_SECRET=
EXA_SSO_HOSTNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Google and Microsoft OAuth apps (free; not created yet).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Backups (deploy/backup): the passphrase every backup is encrypted with.
EXA_BACKUP_PASSPHRASE=
# EXA_BACKUP_RCLONE_REMOTE=offsite:exacarib-backups/controller
# Jibsy channels (ADR 0018). Every channel works with the simulated provider
# while these are empty; the real adapters are not live until they are set.
# WhatsApp and SMS through Twilio (provider not chosen yet).
EXA_TWILIO_ACCOUNT_SID=
EXA_TWILIO_AUTH_TOKEN=
# WhatsApp through 360dialog (provider not chosen yet).
EXA_360DIALOG_API_KEY=
EXA_360DIALOG_WEBHOOK_SECRET=
# Messenger, Instagram and WhatsApp Cloud API through ExaCarib's Meta app (ADR 0029; not live).
EXA_META_APP_ID=
EXA_META_APP_SECRET=
EXA_META_ES_CONFIG_ID=
EXA_META_VERIFY_TOKEN=
# Outbound email by SMTP; a simulated sender is used while EXA_SMTP_HOST is empty.
EXA_SMTP_HOST=
EXA_SMTP_PORT=587
EXA_SMTP_USER=
EXA_SMTP_PASSWORD=
# EXA_SMTP_STARTTLS=true
# Sender address for account emails such as password resets.
# EXA_SMTP_FROM=no-reply@exacarib.com
# Jibsy AI agents (ADR 0019) use EXA_LLM_API_KEY above; without it a simulated
# model answers from approved knowledge only. Server-side speech (DeepInfra) is
# not live until the spend is agreed: set EXA_COMMAI_SERVER_SPEECH=on and a key.
# EXA_COMMAI_SERVER_SPEECH=off
EXA_SPEECH_API_KEY=
# EXA_SPEECH_BASE_URL=https://api.deepinfra.com/v1/openai
# EXA_SPEECH_STT_MODEL=openai/whisper-large-v3-turbo
# EXA_SPEECH_TTS_MODEL=hexgrad/Kokoro-82M
# Jibsy voice (ADR 0021). The SIP provider is simulated (fictional +1 868 555 01xx
# numbers) until Dudley opens an account (phase 3); then set EXA_SIP_PROVIDER=sip.
# EXA_SIP_PROVIDER=simulated
EXA_SIP_PROVIDER_URL=
EXA_SIP_PROVIDER_KEY=
EXA_SIP_USERNAME=
EXA_SIP_PASSWORD=
EXA_SIP_REALM=
# Voice stage 5 (ADR 0033): the real provider's API refuses to run until all three are set.
EXA_SIP_PROVIDER_ACCOUNT=
# LiveKit for AI on phone calls (compose profile "voice"). LIVEKIT_KEYS is "<key>: <secret>".
LIVEKIT_KEYS=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EXA_LIVEKIT_URL=
EXA_LIVEKIT_AGENT_SECRET=
# Jibsy automation (ADR 0020). EXA_SECRETS_KEY encrypts integration tokens at rest
# (make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Google Calendar and HubSpot are NOT live until ExaCarib registers the OAuth apps and
# sets these; HubSpot also accepts a private-app token entered on the Integrations screen.
# The OAuth redirect is {EXA_PUBLIC_URL}/api/v1/commai/oauth/{app}/callback.
EXA_SECRETS_KEY=
# EXA_PORTAL_URL=
EXA_GOOGLE_CLIENT_ID=
EXA_GOOGLE_CLIENT_SECRET=
EXA_HUBSPOT_CLIENT_ID=
EXA_HUBSPOT_CLIENT_SECRET=

# Directory connectors (ADR 0036). Read-only pull of people and groups.
# Microsoft Graph: ExaCarib's multi-tenant Entra app (application permissions
# User.Read.All and GroupMember.Read.All; each business's admin consents).
EXA_MS_GRAPH_CLIENT_ID=
EXA_MS_GRAPH_CLIENT_SECRET=
# Google Directory API: the service account key (JSON, or a path to the file)
# with domain-wide delegation that each business grants.
EXA_GOOGLE_DIRECTORY_CREDENTIALS=
# "lab" allows plain LDAP (no TLS) in ExaCarib's lab only. Leave empty elsewhere.
EXA_DIRECTORY_LDAP_ALLOW_PLAIN=
# More Jibsy connectors (ADR 0035). Each stays on its simulated stand-in until these are
# set and the go-live registry switches integration-<app> on. Freshdesk, ServiceNow and
# Teams incoming webhooks need nothing here: each business enters its own key or address.
EXA_ZENDESK_CLIENT_ID=
EXA_ZENDESK_CLIENT_SECRET=
EXA_SLACK_CLIENT_ID=
EXA_SLACK_CLIENT_SECRET=
EXA_SLACK_SIGNING_SECRET=
EXA_TEAMS_BOT_ID=
EXA_TEAMS_BOT_PASSWORD=
EXA_SHOPIFY_CLIENT_ID=
EXA_SHOPIFY_CLIENT_SECRET=
EXA_STRIPE_CLIENT_ID=
EXA_STRIPE_CLIENT_SECRET=
# Microsoft 365 app, also used by OneDrive and SharePoint.
EXA_MS365_CLIENT_ID=
EXA_MS365_CLIENT_SECRET=
# Jibsy integration catalogue (ADR 0034, docs/commai/integrations.md). Each app runs on
# its stand-in until its OAuth client is registered here AND ExaCarib switches on its
# go-live check (integration-<app>). Gmail uses the EXA_GOOGLE_* client above; Microsoft 365
# mail and calendar share EXA_MS365_CLIENT_ID/SECRET with the OneDrive connector; the
# HubSpot client secret above also checks HubSpot's webhook signatures.
EXA_SALESFORCE_CLIENT_ID=
EXA_SALESFORCE_CLIENT_SECRET=
EXA_DYNAMICS_CLIENT_ID=
EXA_DYNAMICS_CLIENT_SECRET=
EXA_ZOHO_CLIENT_ID=
EXA_ZOHO_CLIENT_SECRET=
EXA_PIPEDRIVE_CLIENT_ID=
EXA_PIPEDRIVE_CLIENT_SECRET=
EXA_CALENDLY_CLIENT_ID=
EXA_CALENDLY_CLIENT_SECRET=

# Voice SBC (deploy/kamailio/README.md): the public address carriers send SIP and media to.
# Empty until the voice host is public; the SBC then advertises loopback only.
EXA_VOICE_PUBLIC_IP=
# Where FreeSWITCH sends outside calls: provider (one SIP provider, the default) or kamailio.
# EXA_VOICE_EDGE=provider
# FreeSWITCH signs its check with the controller before each outside call with this
# (lab/scripts/init-env.sh generates it). Unset: every outside call is refused.
# EXA_PBX_SECRET=
# Kamailio's allow-list entry for FreeSWITCH (CIDR); make voice-up writes it for EXA_VOICE_EDGE=kamailio.
# EXA_KAMAILIO_PBX_NETS=
# Billing (ADR 0022). Online payment of issued invoices is OFF by default.
# EXA_PAYMENTS=off|simulated|live. Simulated never makes a network call; live
# needs the provider's settings below, and a provider without them stays simulated.
# EXA_PAYMENTS=off
# EXA_PAYMENT_PROVIDERS=stripe,hosted
EXA_STRIPE_SECRET_KEY=
EXA_STRIPE_WEBHOOK_SECRET=
# EXA_STRIPE_API_BASE=https://api.stripe.com
# A hosted payment page shaped like First Atlantic Commerce / PowerTranz.
EXA_HOSTED_PAY_URL=
EXA_HOSTED_PAY_MERCHANT_ID=
EXA_HOSTED_PAY_PASSWORD=
EXA_HOSTED_PAY_SECRET=
# Accounting export (Xero and QuickBooks Online payloads, nothing is sent).
# EXA_INVOICE_DUE_DAYS=30
# EXA_XERO_ACCOUNT_CODE=200
# EXA_XERO_TAX_TYPE=
# EXA_QBO_ITEM_CONNECT=Connect
# EXA_QBO_ITEM_COMMAI=Jibsy
# Connect integrations (ADR 0026, docs/integrations.md). Every connector is simulated
# (it records what it would send) until EXA_INTEGRATIONS_LIVE=1 AND its credentials exist.
# Customers' connector credentials are entered in the portal and stored encrypted with
# EXA_SECRETS_KEY above; only platform-wide credentials live here.
# EXA_INTEGRATIONS_LIVE=0
# ExaCarib's IANA private enterprise number for syslog SD-IDs, SNMP OIDs and IPFIX
# (32473, the documentation number, until registered).
# EXA_IANA_PEN=32473
# Cloud on-ramps: ExaCarib's own partner accounts. Each stays simulated until all of its
# names are set (and EXA_INTEGRATIONS_LIVE=1).
EXA_AWS_DX_ACCESS_KEY_ID=
EXA_AWS_DX_SECRET_ACCESS_KEY=
EXA_AWS_DX_INTERCONNECT_ID=
EXA_AZURE_TENANT_ID=
EXA_AZURE_CLIENT_ID=
EXA_AZURE_CLIENT_SECRET=
# The service account's JSON key, on one line.
EXA_GCP_SERVICE_ACCOUNT_JSON=
EXA_GCP_PROJECT=
EXA_GCP_INTERCONNECT=
EXA_MEGAPORT_CLIENT_ID=
EXA_MEGAPORT_CLIENT_SECRET=
EXA_MEGAPORT_PORT_UID=
