# Copy to /etc/exaconnect/backup.env (mode 600, owned by root). Placeholder names only.
EXA_BACKUP_PASSPHRASE=
# Either the compose file (tools run inside the db container)...
EXA_BACKUP_COMPOSE_FILE=/opt/exaconnect/deploy/docker-compose.yml
# ...or a direct connection for local client tools:
# EXA_BACKUP_DATABASE_URL=postgresql://exaconnect@127.0.0.1:5432/exaconnect
# PGPASSWORD=
EXA_BACKUP_KEEP_DAYS=14
# Off-site copy with rclone, once Dudley has set up a remote (rclone config):
# EXA_BACKUP_RCLONE_REMOTE=offsite:exacarib-backups/controller
