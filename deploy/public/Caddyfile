# connect.exacarib.com: the portal and its API, nothing else.
# The controller and database stay on the private compose network; agent
# endpoints are not served here (agents use the mTLS proxy).
# No global options: an empty "email" option is a parse error, and Let's
# Encrypt issues certificates without an account email.

{$EXA_PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Agent-facing endpoints never leave the private networks. These are
	# handle blocks with paths, so Caddy sorts them ahead of /api/* (a bare
	# respond runs after handle and never fired).
	handle /api/v1/agent/* {
		respond 404
	}
	handle /api/v1/enrol {
		respond 404
	}
	handle /api/v1/ca.pem {
		respond 404
	}
	handle /api/* {
		reverse_proxy controller-api:8000
	}
	handle /healthz {
		reverse_proxy controller-api:8000
	}
	handle {
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
