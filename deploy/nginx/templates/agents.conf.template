# Agent-facing TLS endpoint (CLAUDE.md §3: HTTPS with mutual TLS).
# Enrolment and the CA download need only server TLS; everything under
# /api/v1/agent/ needs a client certificate signed by the controller CA.
# The controller trusts the X-SSL-* headers only with the shared proxy secret.
server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate        /data/tls/server.crt;
    ssl_certificate_key    /data/tls/server.key;
    ssl_client_certificate /data/tls/ca.crt;
    ssl_verify_client      optional;
    ssl_protocols          TLSv1.2 TLSv1.3;

    client_max_body_size 4m;

    # Resolve the controller per request through Docker's DNS, so nginx starts
    # without it and follows it across restarts (the controller outage test).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://controller-api:8000;

    proxy_set_header Host $host;
    proxy_set_header X-Exa-Proxy "";
    proxy_set_header X-SSL-Client-Verify "";
    proxy_set_header X-SSL-Client-Serial "";

    location = /api/v1/ca.pem { proxy_pass $api; }
    location = /api/v1/enrol  { proxy_pass $api; }

    location /api/v1/agent/ {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_set_header Host $host;
        proxy_set_header X-Exa-Proxy "${EXA_PROXY_SECRET}";
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
        proxy_pass $api;
    }

    location / { return 404; }
}
