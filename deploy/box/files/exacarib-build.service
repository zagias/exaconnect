# Only in the build VM (deploy/box/build-image.sh): runs the set-up once, then powers off.
[Unit]
Description=Build the ExaCarib box image
After=local-fs.target systemd-networkd.service

[Service]
Type=oneshot
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
ExecStart=/bin/bash -o pipefail -c '/root/exacarib-build.sh 2>&1 | tee /var/log/exacarib-build.log && echo EXACARIB-BUILD-OK; sync; systemctl poweroff'

[Install]
WantedBy=multi-user.target
