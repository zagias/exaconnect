#!/bin/sh
# exacarib-box: stop the box console on removal. Its state in /var/lib/exaconnect stays.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  systemctl disable --now exa-box.service exacarib-box-banner.timer exacarib-setup-dhcp.service >/dev/null 2>&1 || true
  rm -f /etc/issue.d/50-exacarib.issue
fi
exit 0
