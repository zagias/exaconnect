#!/bin/sh
# ExaCarib box (ADR 0047): what the screen on the box shows above the login
# prompt: where to open the box console and, until its admin password is set,
# the setup code. Someone with the box in front of them may see the code; the
# console only answers on the office side.
set -u
out=/run/issue.d/50-exacarib.issue
mkdir -p /run/issue.d
code=$(EXA_STATE_DIR=/var/lib/exaconnect /usr/bin/exa-agent console-code 2>/dev/null | sed -n 's/^Box console setup code: //p')
ver=$(/usr/bin/exa-agent version 2>/dev/null | awk '{print $2}')
{
  echo
  echo "  ExaCarib box (Connect agent ${ver:-unknown})"
  echo
  ip -4 -o addr show scope global 2>/dev/null | awk '{printf "  %-10s %s\n", $2, $4}'
  echo
  if ip -4 -o addr show scope global 2>/dev/null | grep -q ' 192\.168\.50\.1/'; then
    echo "  Box console: https://192.168.50.1 (plug a laptop into the office port)"
  else
    echo "  Box console: https://<this box's office address>, from the office network"
  fi
  if [ -n "$code" ]; then
    echo "  Setup code:  $code"
  fi
  echo
} >"$out.tmp"
mv "$out.tmp" "$out"
# agetty reads /run/issue.d (util-linux 2.36 and later); --reload redraws the prompt.
agetty --reload 2>/dev/null || true
