<!--
  Jibsy browser phone (ADR 0039): FreeSWITCH Verto over secure WebSocket.

  Staff sign in from the portal's dialer with their own extension
  (extension@business-domain) and its SIP password, fetched from
  GET /api/v1/commai/customers/{id}/voice/webphone. Users come from the
  rendered directory (one domain per business), so a person can only sign in
  as their own extension and only reaches their own business's dialplan
  (user_context in the directory).

  Sign-in rides the public proxy: Caddy ends TLS on 443 and passes
  wss://<public host>/verto to this listener on the compose network
  (deploy/public/Caddyfile). Port 8081 is never published on the host.
  The dialer stays off until EXA_VERTO_URL is set for the controller, and call
  audio needs FreeSWITCH's media ports reachable (deploy/voice/README.md).
  Calls outside the business also need the SIP provider (not live yet).
-->
<configuration name="verto.conf" description="ExaCarib Connect browser phone">
  <settings>
    <param name="debug" value="0"/>
  </settings>
  <profiles>
    <profile name="exacarib-wss">
      <!-- Plain WebSocket on the private compose network only; the public proxy adds TLS. -->
      <param name="bind-local" value="0.0.0.0:8081"/>
      <param name="userauth" value="true"/>
      <!-- Every sign-in is checked against the directory; no guest calls. -->
      <param name="blind-reg" value="false"/>
      <param name="mcast-ip" value="224.1.1.1"/>
      <param name="mcast-port" value="1337"/>
      <param name="rtp-ip" value="$${local_ip_v4}"/>
      <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
      <param name="local-network" value="localnet.auto"/>
      <param name="outbound-codec-string" value="opus,pcmu,pcma"/>
      <param name="inbound-codec-string" value="opus,pcmu,pcma"/>
      <param name="apply-candidate-acl" value="localnet.auto"/>
      <param name="apply-candidate-acl" value="wan_v4.auto"/>
      <param name="apply-candidate-acl" value="rfc1918.auto"/>
      <param name="apply-candidate-acl" value="any_v4.auto"/>
      <param name="timer-name" value="soft"/>
      <!-- A signed-in user's calls use their own business's context (user_context in the
           directory). This fallback context does not exist, so a call without one goes nowhere. -->
      <param name="context" value="exacarib-verto"/>
      <param name="dialplan" value="XML"/>
      <param name="force-register-domain" value=""/>
      <param name="enable-text" value="false"/>
    </profile>
  </profiles>
</configuration>
