<!-- Install separately. Never include these fragments in public context. -->
<include>
  <context name="exacarib-protected">
    <X-PRE-PROCESS cmd="include" data="/exacarib/voice-approved/current/protected/routes.xml"/>
    <extension name="protected-default-deny">
      <condition>
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>
  </context>
</include>
