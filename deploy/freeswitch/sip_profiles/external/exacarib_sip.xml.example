<!--
  The gateway the rendered dial plans send outside calls to ("exacarib_sip"), for
  EXA_VOICE_EDGE=provider (the default): one SIP provider, FreeSWITCH registers to it.
  NOT LIVE: there is no SIP provider account yet. `make voice-up` installs this as
  exacarib_sip.xml (git-ignored) once EXA_SIP_USERNAME is set in .env, and FreeSWITCH
  reads EXA_SIP_USERNAME, EXA_SIP_PASSWORD and EXA_SIP_REALM from its environment.
  Never commit real values. With Kamailio in front, see exacarib_sip.kamailio.xml.example.
  The AI agent gateway ("exacarib_ai") comes with LiveKit (deploy/livekit).
-->
<include>
  <!-- The image has no printenv: the shell's echo reads the environment. -->
  <X-PRE-PROCESS cmd="exec-set" data="exa_sip_username=echo $EXA_SIP_USERNAME"/>
  <X-PRE-PROCESS cmd="exec-set" data="exa_sip_password=echo $EXA_SIP_PASSWORD"/>
  <X-PRE-PROCESS cmd="exec-set" data="exa_sip_realm=echo $EXA_SIP_REALM"/>
  <gateway name="exacarib_sip">
    <param name="username" value="$${exa_sip_username}"/>
    <param name="password" value="$${exa_sip_password}"/>
    <param name="realm" value="$${exa_sip_realm}"/>
    <param name="proxy" value="$${exa_sip_realm}"/>
    <param name="register" value="true"/>
    <param name="caller-id-in-from" value="true"/>
  </gateway>
</include>
