# Underlay profiles from CLAUDE.md §4.7. Values are round-trip figures:
# netem.sh applies half the delay and jitter in each direction, and the loss
# once (toward the PoP) unless LOSS_BOTH_WAYS=1, so a probe sees roughly these
# numbers. See docs/adr/0002.
#            delay_ms jitter_ms loss_pct
CARRIER_A="25 2 0"
CARRIER_B="35 4 0"
SAT_LEO="45 10 0.5"
SAT_GEO="600 30 1"
# Which satellite profile the "sat" router uses: leo or geo.
SAT_PROFILE="${SAT_PROFILE:-leo}"
# 1 splits each link's loss across both directions instead of applying it
# once toward the PoP (ADR 0002). Off by default.
LOSS_BOTH_WAYS="${LOSS_BOTH_WAYS:-0}"
